---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="mb-[13px] flex items-center gap-[10px]">
  <div class="flex gap-1 opacity-50">
    <div class="w-1 h-3 bg-amber-500"></div>
    <div class="w-0.5 h-3 bg-amber-500"></div>
    <div class="w-2 h-3 bg-amber-500"></div>
  </div>
  <h3
    class="text-[11px] font-robotic text-gray-400 uppercase tracking-[0.2em] leading-none"
  >
    {title}
  </h3>
  <div class="h-[1px] flex-1 bg-gradient-to-r from-gray-700 to-transparent">
  </div>
</div>
