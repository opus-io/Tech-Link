---
import { logoMap } from "../data/products";

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;

const isFeatured = product.variant === "featured";
const delay = index * 100 + 200;

const fullStars = Math.floor(product.rating || 0);
const hasHalf = (product.rating || 0) - fullStars >= 0.5;

function formatSold(val?: number): string {
  if (!val) return "";
  if (val >= 1000) return (val / 1000).toFixed(0) + "rb";
  return val.toString();
}

function getPlatformLogo(tag: string): string {
  return logoMap[tag.toUpperCase()] || "";
}

// Match link label to platform tag for logo
function getLogoForLink(label: string): { logo: string; tag: string } {
  const upper = label.toUpperCase();
  for (const tag of product.tags) {
    if (upper.includes(tag)) {
      return { logo: getPlatformLogo(tag), tag };
    }
  }
  return { logo: "", tag: "" };
}

const variantClasses = isFeatured
  ? "border-amber-500/30 hover:border-amber-500/70 card-featured-glow"
  : "border border-gray-800 hover:border-gray-600 shadow-sm";

const titleClasses = isFeatured
  ? "text-gray-200"
  : "text-gray-300";
---

<div
  class={`product-card relative bg-[#121212] rounded-[13px] overflow-hidden transition-all duration-300 group ${variantClasses}`}
  data-url={product.defaultUrl}
  role="article"
  aria-label={`Product: ${product.title}`}
  style={`animation-delay: ${delay}ms`}
>
  {isFeatured && (
    <div class="absolute inset-0 rounded-[13px] pointer-events-none card-glow-overlay" />
  )}

  <div
    class="absolute top-0 right-0 bg-[#1A1A1A] border-b border-l border-gray-800 px-2 py-1 rounded-bl-lg z-20"
  >
    <span class="font-robotic text-[9px] text-gray-500">ID:{product.id}</span>
  </div>

  <div
    class="p-[21px] flex items-center justify-between gap-[13px] relative z-10"
  >
    <div class="fast-lane flex items-center gap-[13px] flex-1 cursor-pointer group/fast">
      <div class="relative border border-gray-700 rounded-lg p-0.5 bg-[#1A1A1A] transition-all duration-300 group-hover/fast:border-amber-500/40 group-hover/fast:shadow-[0_0_13px_rgba(245,158,11,0.15)]">
        <img
          src={product.image}
          alt={product.imageAlt}
          loading="lazy"
          decoding="async"
          class="w-[55px] h-[55px] object-cover rounded-md opacity-90 transition-all duration-300 group-hover/fast:opacity-100 group-hover/fast:scale-[1.04]"
        />
      </div>
      <div class="flex-1 min-w-0">
        {
          product.featured ? (
            <span class="text-[9px] font-robotic text-amber-500 tracking-widest mb-[4px] block flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse" />
              {product.badge}
            </span>
          ) : (
            <span class="text-[8px] font-robotic text-gray-500 uppercase tracking-widest mb-[4px] block">
              {product.badge}
            </span>
          )
        }
        <h2
          class={`text-[15px] font-bold transition-colors leading-tight group-hover/fast:text-amber-400/80 ${titleClasses}`}
        >
          {product.title}
        </h2>

        {(product.rating || product.sold) && (
          <div class="flex items-center gap-[8px] mt-[5px]">
            {product.rating && (
              <span class="flex items-center gap-[2px] text-[11px] text-gray-400">
                <span class="text-amber-500 text-[12px]">★</span>
                {product.rating}
              </span>
            )}
            {product.sold && (
              <span class="text-[11px] text-gray-500">
                {formatSold(product.sold)} terjual
              </span>
            )}
          </div>
        )}

        {product.shortDesc && (
          <p class="text-[11px] font-robotic text-gray-500 mt-[5px] leading-snug line-clamp-1">
            {product.shortDesc}
          </p>
        )}

        {product.tags.length > 0 && (
          <div class="flex gap-[6px] mt-[7px] flex-wrap">
            {product.tags.map((tag) => {
              const logoPath = getPlatformLogo(tag);
              return (
                <span class="inline-flex items-center gap-1.5 bg-[#1A1A1A] border border-gray-700 px-[7px] py-[3px] rounded-sm">
                  {logoPath && (
                    <img
                      src={logoPath}
                      alt=""
                      class="w-[13px] h-[13px] object-contain"
                      loading="lazy"
                    />
                  )}
                  <span class="text-[9px] font-robotic text-gray-400">{tag}</span>
                </span>
              );
            })}
          </div>
        )}
      </div>
    </div>

    <button
      class="toggle-btn w-[34px] h-[34px] rounded-sm bg-[#1A1A1A] hover:bg-[#2A2A2A] border border-gray-700 flex items-center justify-center transition-colors shrink-0"
      aria-label={`Toggle details for ${product.title}`}
      aria-expanded="false"
    >
      <svg
        class="w-[14px] h-[14px] text-gray-400 transform transition-transform duration-300 arrow-icon"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
          d="M19 9l-7 7-7-7"></path>
      </svg>
    </button>
  </div>

  <div class="glass-accordion border-t border-gray-800 bg-[#0F0F0F]">
    <div class="p-[21px] flex flex-col gap-[21px]">
      <p
        class="text-[12px] font-robotic text-gray-400 leading-relaxed border-l-2 border-gray-700 pl-3"
      >
        <strong class="text-gray-300 block mb-[2px]">LOG_NOTE:</strong>
        {product.description}
      </p>

      <div class="flex flex-col gap-[13px]">
        <span class="text-[10px] font-robotic text-gray-500 tracking-wider uppercase">
          Tersedia di :
        </span>
        <div class="flex gap-[13px] flex-wrap">
          {product.links.map((link) => {
            const { logo, tag } = getLogoForLink(link.label);
            return (
              <a
                href={link.href}
                class="flex items-center gap-[8px] bg-[#141414] border border-gray-800 hover:border-gray-600 px-[13px] py-[8px] rounded-sm transition-colors"
              >
                {logo && (
                  <img
                    src={logo}
                    alt={tag}
                    class="w-[18px] h-[18px] object-contain"
                  />
                )}
                <span class="text-[11px] font-robotic text-gray-300">
                  {link.label.replace(/ACCESS \/\//, "").trim()}
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initProductCard() {
    const cards = document.querySelectorAll<HTMLElement>(".product-card");
    
    cards.forEach((card) => {
      const fastLane = card.querySelector<HTMLElement>(".fast-lane");
      const toggleBtn = card.querySelector<HTMLElement>(".toggle-btn");
      const accordion = card.querySelector<HTMLElement>(".glass-accordion");
      const arrow = card.querySelector<HTMLElement>(".arrow-icon");
      const defaultUrl = card.getAttribute("data-url");

      if (!fastLane || !toggleBtn || !accordion || !arrow || !defaultUrl) {
        return;
      }

      const handleFastLaneClick = () => {
        if (!card.classList.contains("is-open")) {
          window.open(defaultUrl, "_blank", "noopener,noreferrer");
        }
      };

      const handleToggleClick = (e: Event) => {
        e.stopPropagation();
        if (card.classList.contains("is-open")) {
          card.classList.remove("is-open");
          accordion.style.maxHeight = "0px";
          arrow.classList.remove("rotate-180");
          toggleBtn.setAttribute("aria-expanded", "false");
        } else {
          card.classList.add("is-open");
          accordion.style.maxHeight = `${accordion.scrollHeight}px`;
          arrow.classList.add("rotate-180");
          toggleBtn.setAttribute("aria-expanded", "true");
        }
      };

      fastLane.addEventListener("click", handleFastLaneClick);
      toggleBtn.addEventListener("click", handleToggleClick);

      const cleanup = () => {
        fastLane.removeEventListener("click", handleFastLaneClick);
        toggleBtn.removeEventListener("click", handleToggleClick);
      };

      (card as any)._cleanup = cleanup;
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProductCard);
  } else {
    initProductCard();
  }

  document.addEventListener("astro:before-swap", () => {
    document.querySelectorAll<HTMLElement>(".product-card").forEach((card) => {
      if ((card as any)._cleanup) {
        (card as any)._cleanup();
      }
    });
  });
</script>
