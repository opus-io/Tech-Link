---
// Load config for diagnostic text
let diagnosticLines = [
  "> INIT: PRODUCT DIRECTORY...",
  "> LOAD: MECHANICAL SETUPS...",
  "> SYNC: AFFILIATE STREAMS...",
  "> AUTH: SYSTEM VERIFIED.",
];
let diagnosticTags = [
  "SYS.V.2.0.4 // ONLINE",
  "MODULE // SECURE",
  "UPTIME // 047:21:18",
  "NODES // CONNECTED",
  "SIGNAL // 98.7%",
  "ENCRYPT // AES-256",
];
try {
  const config = await import("../../content/config.json", { assert: { type: "json" } });
  const cfg = (config as any).default || config;
  if (cfg.diagnosticLines) diagnosticLines = cfg.diagnosticLines;
  if (cfg.diagnosticTags) diagnosticTags = cfg.diagnosticTags;
} catch {}

// Serialize for client-side use
const linesJson = JSON.stringify(diagnosticLines);
const tagsJson = JSON.stringify(diagnosticTags);
const accentColor = "#f59e0b";
---

<div
  class="absolute top-0 left-0 w-full h-[34vh] z-0 overflow-hidden bg-[#0A0A0C] border-b border-[#2A2A2A]"
  aria-hidden="true"
>
  <canvas
    id="diagnosticCanvas"
    class="w-full h-full absolute top-0 left-0"
  ></canvas>
  <div
    class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0A0A0C]/80 to-[#0A0A0C] z-20 pointer-events-none"
    aria-hidden="true"
  >
  </div>
</div>
<script>
  const diagnosticLines = JSON.parse('{linesJson}');
  const diagnosticTags = JSON.parse('{tagsJson}');
  const ACCENT = '{accentColor}';

  function initDiagnosticCanvas() {
    const canvas = document.getElementById("diagnosticCanvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animationFrameId: number | null = null;

    function resizeCanvas() {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight * 0.35;
    }

    const handleResize = () => resizeCanvas();
    window.addEventListener("resize", handleResize);
    resizeCanvas();

    // Typewriter variables
    let phraseIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let typeTimer = 0;
    let isHolding = false;

    // Animated elements
    let gridOffset = 0;
    let scanlineY = 0;
    let lastFrameTime = 0;
    const frameInterval = 1000 / 30;

    // Matrix rain effect
    interface Drop {
      x: number;
      y: number;
      speed: number;
      chars: string[];
    }
    let matrixDrops: Drop[] = [];

    // Glitch effect
    let glitchTimer = 0;
    let glitchActive = false;
    let glitchDuration = 0;
    let glitchX = 0;
    let glitchY = 0;
    let glitchW = 0;

    // Data stream particles
    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      life: number;
      maxLife: number;
    }
    let particles: Particle[] = [];

    function initMatrix() {
      matrixDrops = [];
      const cols = Math.floor(width / 14);
      for (let i = 0; i < cols; i++) {
        if (Math.random() > 0.85) {
          matrixDrops.push({
            x: i * 14,
            y: -Math.random() * height,
            speed: 0.3 + Math.random() * 0.8,
            chars: [],
          });
        }
      }
    }

    function spawnParticle() {
      if (particles.length > 30) return;
      const angle = Math.random() * Math.PI * 2;
      const speed = 0.2 + Math.random() * 0.5;
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height * 0.5,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        life: 0,
        maxLife: 60 + Math.random() * 60,
      });
    }

    function renderDiagnosticCanvas(currentTime: number = performance.now()) {
      if (currentTime - lastFrameTime < frameInterval) {
        animationFrameId = requestAnimationFrame((t) => renderDiagnosticCanvas(t));
        return;
      }
      lastFrameTime = currentTime;

      if (!ctx || !canvas) return;

      // Clear
      ctx.fillStyle = "#0A0A0C";
      ctx.fillRect(0, 0, width, height);

      // 1. ANIMATED BLUEPRINT GRID
      gridOffset += 0.3;
      const gridSize = 25;
      if (gridOffset >= gridSize) gridOffset = 0;

      ctx.strokeStyle = "rgba(255, 255, 255, 0.04)";
      ctx.lineWidth = 1;
      for (let x = gridOffset; x < width; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }
      for (let y = gridOffset; y < height; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();
      }

      // 2. SECONDARY FINE GRID (offset)
      ctx.strokeStyle = "rgba(245, 158, 11, 0.02)";
      const fineGrid = 8;
      for (let x = -gridOffset * 2; x < width; x += fineGrid * 3) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }

      // 3. SINE WAVE LINE
      ctx.strokeStyle = "rgba(245, 158, 11, 0.04)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let x = 0; x < width; x += 2) {
        const y = (height * 0.15) + Math.sin((x + currentTime * 0.002) * 0.008) * 8;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();

      // 4. RADAR SCANLINE
      scanlineY += 1.2;
      if (scanlineY > height) scanlineY = 0;

      ctx.fillStyle = "rgba(245, 158, 11, 0.15)";
      ctx.fillRect(0, scanlineY, width, 2);
      const scanGrad = ctx.createLinearGradient(0, scanlineY - 30, 0, scanlineY);
      scanGrad.addColorStop(0, "rgba(245, 158, 11, 0)");
      scanGrad.addColorStop(1, "rgba(245, 158, 11, 0.04)");
      ctx.fillStyle = scanGrad;
      ctx.fillRect(0, scanlineY - 30, width, 30);

      // 5. CORNER RADAR GRID
      const cx = 55;
      const cy = height - 55;
      ctx.strokeStyle = "rgba(245, 158, 11, 0.06)";
      ctx.lineWidth = 0.5;
      for (let r = 20; r < 80; r += 15) {
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 0.5);
        ctx.stroke();
      }
      // Radar sweep
      const angle = (currentTime * 0.001) % (Math.PI * 0.5);
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(angle) * 75, cy - Math.sin(angle) * 75);
      ctx.strokeStyle = "rgba(245, 158, 11, 0.12)";
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // 6. DIAGNOSTIC TAGS (sidebars)
      ctx.font = "9px 'Share Tech Mono', monospace";
      ctx.textAlign = "left";
      const pulse = Math.sin(currentTime * 0.003) * 0.15 + 0.5;
      diagnosticTags.forEach((tag, i) => {
        ctx.fillStyle = `rgba(161, 161, 170, ${0.4 + pulse * 0.2})`;
        ctx.fillText(tag, 15, 20 + i * 14);
      });

      // Right side tags
      ctx.textAlign = "right";
      const rightTags = ["DATA // STREAMING", "PROC // OPTIMAL", "TEMP // 42°C", "MEM // 34%"];
      rightTags.forEach((tag, i) => {
        ctx.fillStyle = `rgba(245, 158, 11, ${0.2 + pulse * 0.15})`;
        ctx.fillText(tag, width - 15, 20 + i * 14);
      });

      // 7. MATRIX RAIN (sparse)
      if (matrixDrops.length < 8 && Math.random() > 0.95) initMatrix();
      ctx.font = "8px 'Share Tech Mono', monospace";
      matrixDrops.forEach((drop) => {
        drop.y += drop.speed;
        if (drop.y > height) drop.y = -20;
        const alpha = 0.03 + Math.random() * 0.04;
        ctx.fillStyle = `rgba(245, 158, 11, ${alpha})`;
        const char = String.fromCharCode(0x30A0 + Math.floor(Math.random() * 96));
        ctx.fillText(char, drop.x, drop.y);
      });

      // 8. DATA STREAM PARTICLES
      if (Math.random() > 0.92) spawnParticle();
      particles = particles.filter((p) => p.life < p.maxLife);
      particles.forEach((p) => {
        p.x += p.vx;
        p.y += p.vy;
        p.life++;
        const alpha = (1 - p.life / p.maxLife) * 0.3;
        ctx.fillStyle = `rgba(245, 158, 11, ${alpha})`;
        ctx.fillRect(p.x, p.y, 1.5, 1.5);
        // Trail
        ctx.fillStyle = `rgba(245, 158, 11, ${alpha * 0.3})`;
        ctx.fillRect(p.x - p.vx * 3, p.y - p.vy * 3, 1, 1);
      });

      // 9. GLITCH EFFECT (random)
      glitchTimer++;
      if (!glitchActive && glitchTimer > 180 + Math.random() * 300) {
        glitchActive = true;
        glitchDuration = 2 + Math.floor(Math.random() * 4);
        glitchX = Math.random() * width * 0.7;
        glitchY = 30 + Math.random() * (height * 0.5);
        glitchW = 20 + Math.random() * 100;
        glitchTimer = 0;
      }
      if (glitchActive) {
        glitchDuration--;
        if (glitchDuration > 0) {
          ctx.fillStyle = `rgba(245, 158, 11, ${0.05 + Math.random() * 0.1})`;
          ctx.fillRect(glitchX, glitchY, glitchW, 2 + Math.random() * 4);
          ctx.fillStyle = `rgba(255, 255, 255, ${0.02 + Math.random() * 0.05})`;
          ctx.fillRect(glitchX + 2, glitchY + 1, glitchW - 4, 1);
        } else {
          glitchActive = false;
        }
      }

      // 10. TYPEWRITER TEXT
      if (!isHolding) {
        typeTimer++;
        if (typeTimer > 2) {
          typeTimer = 0;
          if (!isDeleting) {
            charIndex++;
            if (charIndex > diagnosticLines[phraseIndex].length) {
              isHolding = true;
              setTimeout(() => {
                isHolding = false;
                isDeleting = true;
              }, 4000);
            }
          } else {
            charIndex -= 3;
            if (charIndex <= 0) {
              charIndex = 0;
              isDeleting = false;
              phraseIndex = (phraseIndex + 1) % diagnosticLines.length;
            }
          }
        }
      }

      const currentText = diagnosticLines[phraseIndex].substring(0, charIndex);
      const cursor = Math.floor(Date.now() / 300) % 2 === 0 ? "_" : " ";

      ctx.font = "bold 18px 'Share Tech Mono', monospace";
      ctx.fillStyle = "#FFFFFF";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      ctx.shadowColor = `rgba(245, 158, 11, 0.4)`;
      ctx.shadowBlur = 8;
      ctx.fillText(currentText + cursor, width / 2, height / 2);
      ctx.shadowBlur = 0;

      // Small subtitle under typewriter
      ctx.font = "9px 'Share Tech Mono', monospace";
      ctx.fillStyle = "rgba(161, 161, 170, 0.3)";
      ctx.textBaseline = "top";
      ctx.fillText("▼ scroll to browse", width / 2, height / 2 + 28);

      animationFrameId = requestAnimationFrame((time) => renderDiagnosticCanvas(time));
    }

    document.fonts.ready.then(() => {
      initMatrix();
      renderDiagnosticCanvas();
    });

    const cleanup = () => {
      window.removeEventListener("resize", handleResize);
      if (animationFrameId !== null) {
        cancelAnimationFrame(animationFrameId);
      }
    };

    (canvas as any)._cleanup = cleanup;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDiagnosticCanvas);
  } else {
    initDiagnosticCanvas();
  }

  document.addEventListener("astro:before-swap", () => {
    const canvas = document.getElementById("diagnosticCanvas") as any;
    if (canvas && canvas._cleanup) {
      canvas._cleanup();
    }
  });
</script>
