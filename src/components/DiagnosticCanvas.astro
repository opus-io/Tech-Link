---
let diagnosticLines = [
  "> INIT: PRODUCT DIRECTORY...",
  "> LOAD: MECHANICAL SETUPS...",
  "> SYNC: AFFILIATE STREAMS...",
  "> AUTH: SYSTEM VERIFIED.",
];
let diagnosticTags = [
  "SYS.V.2.0.4 // ONLINE",
  "MODULE // SECURE",
  "UPTIME // 047:21:18",
  "NODES // CONNECTED",
  "SIGNAL // 98.7%",
  "ENCRYPT // AES-256",
];
try {
  const config = await import("../../content/config.json", { assert: { type: "json" } });
  const cfg = config.default || config;
  if (cfg.diagnosticLines) diagnosticLines = cfg.diagnosticLines;
  if (cfg.diagnosticTags) diagnosticTags = cfg.diagnosticTags;
} catch {}

const linesJson = JSON.stringify(diagnosticLines);
const tagsJson = JSON.stringify(diagnosticTags);
---

<div
  class="absolute top-0 left-0 w-full h-[34vh] z-0 overflow-hidden bg-[#0A0A0C] border-b border-[#2A2A2A]"
  aria-hidden="true"
>
  <canvas
    id="diagnosticCanvas"
    class="w-full h-full absolute top-0 left-0"
  ></canvas>
  <div
    class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0A0A0C]/80 to-[#0A0A0C] z-20 pointer-events-none"
    aria-hidden="true"
  >
  </div>
</div>
<script>
  var diagnosticLines = JSON.parse('{linesJson}');
  var diagnosticTags = JSON.parse('{tagsJson}');

  function initDiagnosticCanvas() {
    var canvas = document.getElementById("diagnosticCanvas");
    if (!canvas) return;
    var ctx = canvas.getContext("2d");
    if (!ctx) return;

    var width = 0;
    var height = 0;
    var animId = null;

    function resize() {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight * 0.35;
    }
    window.addEventListener("resize", resize);
    resize();

    // Typewriter state
    var phraseIdx = 0, charIdx = 0, isDel = false, typeTimer = 0, holding = false;

    // Animation vars
    var gridOff = 0, scanY = 0, lastTime = 0;
    var frameInterval = 1000 / 30;

    // Matrix drops
    var drops = [];

    // Glitch
    var glitchTimer = 0, glitching = false, glitchDur = 0;

    // Particles
    var particles = [];

    function initDrops() {
      var cols = Math.floor(width / 14);
      for (var i = 0; i < cols; i++) {
        if (Math.random() > 0.9) {
          drops.push({ x: i * 14, y: -Math.random() * height, spd: 0.3 + Math.random() * 0.8 });
        }
      }
    }

    function addParticle() {
      if (particles.length > 30) return;
      var a = Math.random() * Math.PI * 2;
      var s = 0.2 + Math.random() * 0.5;
      particles.push({
        x: Math.random() * width, y: Math.random() * height * 0.5,
        vx: Math.cos(a) * s, vy: Math.sin(a) * s,
        life: 0, max: 60 + Math.random() * 60
      });
    }

    function draw(t) {
      if (t - lastTime < frameInterval) { animId = requestAnimationFrame(draw); return; }
      lastTime = t;
      if (!ctx || !canvas) return;

      ctx.fillStyle = "#0A0A0C";
      ctx.fillRect(0, 0, width, height);

      // Grid
      gridOff += 0.3;
      var gs = 25;
      if (gridOff >= gs) gridOff = 0;
      ctx.strokeStyle = "rgba(255,255,255,0.04)";
      ctx.lineWidth = 1;
      for (var x = gridOff; x < width; x += gs) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
      }
      for (var y = gridOff; y < height; y += gs) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
      }

      // Fine grid
      ctx.strokeStyle = "rgba(245,158,11,0.02)";
      for (var x = -gridOff * 2; x < width; x += 24) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
      }

      // Sine wave
      ctx.strokeStyle = "rgba(245,158,11,0.04)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (var x = 0; x < width; x += 2) {
        var sy = height * 0.15 + Math.sin((x + t * 0.002) * 0.008) * 8;
        if (x === 0) ctx.moveTo(x, sy); else ctx.lineTo(x, sy);
      }
      ctx.stroke();

      // Radar scanline
      scanY += 1.2;
      if (scanY > height) scanY = 0;
      ctx.fillStyle = "rgba(245,158,11,0.15)";
      ctx.fillRect(0, scanY, width, 2);
      var grad = ctx.createLinearGradient(0, scanY - 30, 0, scanY);
      grad.addColorStop(0, "rgba(245,158,11,0)");
      grad.addColorStop(1, "rgba(245,158,11,0.04)");
      ctx.fillStyle = grad;
      ctx.fillRect(0, scanY - 30, width, 30);

      // Corner radar
      var cx = 55, cy = height - 55;
      ctx.strokeStyle = "rgba(245,158,11,0.06)";
      ctx.lineWidth = 0.5;
      for (var r = 20; r < 80; r += 15) {
        ctx.beginPath(); ctx.arc(cx, cy, r, 0, Math.PI * 0.5); ctx.stroke();
      }
      var ang = (t * 0.001) % (Math.PI * 0.5);
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(ang) * 75, cy - Math.sin(ang) * 75);
      ctx.strokeStyle = "rgba(245,158,11,0.12)";
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // Diagnostic tags (left)
      ctx.font = "9px 'Share Tech Mono', monospace";
      ctx.textAlign = "left";
      var pulse = Math.sin(t * 0.003) * 0.15 + 0.5;
      for (var i = 0; i < diagnosticTags.length; i++) {
        ctx.fillStyle = "rgba(161,161,170," + (0.4 + pulse * 0.2) + ")";
        ctx.fillText(diagnosticTags[i], 15, 20 + i * 14);
      }

      // Right tags
      ctx.textAlign = "right";
      var rightTags = ["DATA // STREAMING", "PROC // OPTIMAL", "TEMP // 42°C", "MEM // 34%"];
      for (var i = 0; i < rightTags.length; i++) {
        ctx.fillStyle = "rgba(245,158,11," + (0.2 + pulse * 0.15) + ")";
        ctx.fillText(rightTags[i], width - 15, 20 + i * 14);
      }

      // Matrix rain
      if (drops.length < 8 && Math.random() > 0.95) initDrops();
      ctx.font = "8px 'Share Tech Mono', monospace";
      for (var i = 0; i < drops.length; i++) {
        drops[i].y += drops[i].spd;
        if (drops[i].y > height) drops[i].y = -20;
        var a = 0.03 + Math.random() * 0.04;
        ctx.fillStyle = "rgba(245,158,11," + a + ")";
        ctx.fillText(String.fromCharCode(0x30A0 + Math.floor(Math.random() * 96)), drops[i].x, drops[i].y);
      }

      // Data particles
      if (Math.random() > 0.92) addParticle();
      particles = particles.filter(function(p) { return p.life < p.max; });
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i];
        p.x += p.vx; p.y += p.vy; p.life++;
        var a = (1 - p.life / p.max) * 0.3;
        ctx.fillStyle = "rgba(245,158,11," + a + ")";
        ctx.fillRect(p.x, p.y, 1.5, 1.5);
        ctx.fillStyle = "rgba(245,158,11," + a * 0.3 + ")";
        ctx.fillRect(p.x - p.vx * 3, p.y - p.vy * 3, 1, 1);
      }

      // Random glitch
      glitchTimer++;
      if (!glitching && glitchTimer > 180 + Math.random() * 300) {
        glitching = true;
        glitchDur = 2 + Math.floor(Math.random() * 4);
        glitchTimer = 0;
      }
      if (glitching) {
        glitchDur--;
        if (glitchDur > 0) {
          var gx = Math.random() * width * 0.7;
          var gy = 30 + Math.random() * height * 0.5;
          var gw = 20 + Math.random() * 100;
          ctx.fillStyle = "rgba(245,158,11," + (0.05 + Math.random() * 0.1) + ")";
          ctx.fillRect(gx, gy, gw, 2 + Math.random() * 4);
          ctx.fillStyle = "rgba(255,255,255," + (0.02 + Math.random() * 0.05) + ")";
          ctx.fillRect(gx + 2, gy + 1, gw - 4, 1);
        } else {
          glitching = false;
        }
      }

      // Typewriter
      if (!holding) {
        typeTimer++;
        if (typeTimer > 2) {
          typeTimer = 0;
          if (!isDel) {
            charIdx++;
            if (charIdx > diagnosticLines[phraseIdx].length) {
              holding = true;
              setTimeout(function() { holding = false; isDel = true; }, 4000);
            }
          } else {
            charIdx -= 3;
            if (charIdx <= 0) {
              charIdx = 0; isDel = false;
              phraseIdx = (phraseIdx + 1) % diagnosticLines.length;
            }
          }
        }
      }

      var text = diagnosticLines[phraseIdx].substring(0, charIdx);
      var cursor = Math.floor(Date.now() / 300) % 2 === 0 ? "_" : " ";

      ctx.font = "bold 18px 'Share Tech Mono', monospace";
      ctx.fillStyle = "#FFFFFF";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";
      ctx.shadowColor = "rgba(245,158,11,0.4)";
      ctx.shadowBlur = 8;
      ctx.fillText(text + cursor, width / 2, height / 2);
      ctx.shadowBlur = 0;

      ctx.font = "9px 'Share Tech Mono', monospace";
      ctx.fillStyle = "rgba(161,161,170,0.3)";
      ctx.textBaseline = "top";
      ctx.fillText("▼ scroll to browse", width / 2, height / 2 + 28);

      animId = requestAnimationFrame(draw);
    }

    document.fonts.ready.then(function() {
      initDrops();
      draw(performance.now());
    });

    var cleanup = function() {
      window.removeEventListener("resize", resize);
      if (animId !== null) cancelAnimationFrame(animId);
    };
    canvas._cleanup = cleanup;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDiagnosticCanvas);
  } else {
    initDiagnosticCanvas();
  }

  document.addEventListener("astro:before-swap", function() {
    var c = document.getElementById("diagnosticCanvas");
    if (c && c._cleanup) c._cleanup();
  });
</script>
