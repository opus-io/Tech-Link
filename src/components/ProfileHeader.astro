---
let siteName = "@artifak.tech";
let tagline = "CURATED DESK SETUPS.";
let avatarUrl = "https://images.unsplash.com/photo-1632292224971-0d45778b3af9?auto=format&fit=crop&w=150&h=150";

try {
  const config = await import("../../content/config.json", { assert: { type: "json" } });
  const cfg = (config as any).default || config;
  if (cfg.siteName) siteName = cfg.siteName;
  if (cfg.tagline) tagline = cfg.tagline;
  if (cfg.avatarUrl) avatarUrl = cfg.avatarUrl;
} catch {}
---

<header class="flex items-center gap-[21px] mb-[34px]">
  <figure
    class="w-[89px] h-[89px] rounded-lg overflow-hidden shrink-0 shadow-[0_0_21px_rgba(245,158,11,0.15)] border border-[#333333] bg-[#121212] relative z-10 hud-corners p-1"
  >
    <img
      src={avatarUrl}
      alt={`Profile avatar for ${siteName}`}
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover grayscale-[30%] rounded-md"
    />
  </figure>
  <div class="relative z-10">
    <h1
      class="text-[24px] font-robotic tracking-wider text-gray-100 leading-none"
    >
      [ <span class="text-white">{siteName}</span> ]
    </h1>
    <p class="text-[14px] font-robotic text-gray-500 mt-[10px] leading-snug">
      <span class="text-amber-500" aria-label="icon">>></span> {tagline}
    </p>
  </div>
</header>
